# ======================================================
# CONFIGURACIÓN DE BASE DE DATOS (MySQL + Prisma ORM)
# ======================================================
# Reemplaza usuario, contraseña, host, puerto y nombre de base de datos
DATABASE_URL="mysql://root:password@localhost:3306/lotto_db?schema=public"

# ======================================================
# CACHÉ DE ALTA VELOCIDAD (Upstash Redis)
# ======================================================
# Obtén estas credenciales en https://console.upstash.com
# Si se dejan en blanco, el sistema usará un Fallback de Caché en Memoria Local.
UPSTASH_REDIS_REST_URL="https://your-upstash-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ======================================================
# CONFIGURACIÓN DE LA APLICACIÓN Y SEO
# ======================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Token secreto para invalidación de caché vía Webhook/Scraper
REVALIDATE_SECRET="super_secret_revalidation_token_2026"
