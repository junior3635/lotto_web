generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum DrawStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// Tipo de bola dentro de un sorteo. Unifica additionalNumbers[],
// bonusNumbers[] y prizeMultipliers[] del payload original, que en
// realidad describen las mismas bolas desde tres ángulos distintos
// (reglas técnicas, nombre visible, y si es un multiplicador).
enum BallCategory {
  MAIN         // bolas principales (winningNumbers)
  ADDITIONAL   // bola extra elegida por el jugador (powerball, mega_ball, lucky_ball...)
  MULTIPLIER   // multiplicador de premio (power play, megaplier)
}

// ============================================================
// 1. Country
// ============================================================
model Country {
  id        String   @id @default(cuid())
  code      String   @unique // ISO code, ej. "US"
  name      String
  slug      String   @unique
  flagEmoji String
  currency  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states         State[]
  apiRequestLogs ApiRequestLog[]

  @@map("countries")
}

// ============================================================
// 2. State
// Proviene del objeto "state": { state, stateCode, slug, taxRate, minimumLegalAge }
// que aparece repetido en múltiples endpoints del proveedor.
// ============================================================
model State {
  id              String   @id @default(cuid())
  countryId       String
  name            String // "Delaware"
  code            String // "DE"
  slug            String
  taxRate         Decimal  @db.Decimal(5, 2) // "%0.00" -> 0.00, "%4.80" -> 4.80
  minimumLegalAge Int      @default(18)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  lotteries Lottery[]

  @@unique([countryId, code])
  @@unique([countryId, slug])
  @@index([countryId])
  @@map("states")
}

// ============================================================
// 3. Lottery
// Antes: campos sueltos en el modelo Lottery original + "gameDetails"
// del JSON. Ahora es el catálogo puro (identidad del juego); las reglas
// técnicas se separan en LotteryConfiguration.
// ============================================================
model Lottery {
  id           String   @id @default(cuid())
  externalId   Int? // gameDetails.id / game-list[].id del proveedor -> evita duplicar al sincronizar
  stateId      String
  name         String // gameName, ej. "Powerball"
  slug         String
  mainDrawName String? // "Main draw"
  logoUrl      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  state         State                 @relation(fields: [stateId], references: [id], onDelete: Cascade)
  configuration LotteryConfiguration?
  ballTypes     LotteryBallType[]
  drawSchedules LotteryDrawSchedule[]
  draws         Draw[]

  @@unique([stateId, slug])
  @@index([stateId])
  @@index([externalId])
  @@map("lotteries")
}

// ============================================================
// 4. LotteryConfiguration (1:1 con Lottery)
// Se separa del catálogo para poder auditar/versionar cambios de
// reglas del juego sin tocar la identidad (nombre, slug, logo).
// ============================================================
model LotteryConfiguration {
  id                     String   @id @default(cuid())
  lotteryId              String   @unique
  drawTimezone           String?
  drawTime               String?
  stopSaleTime           String?
  claimDeadline          Int? // días para reclamar el premio
  allowZero              Boolean  @default(false)
  minBall                Int
  maxBall                Int
  drawnNumbers           Int // cuántas bolas principales se sortean
  selectableBalls        Int
  minimumSelectableBalls Int
  uniqueMainNumbers      Int      @default(1)
  uniqueExtraNumbers     Int?
  allowDuplicates        Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  lottery Lottery @relation(fields: [lotteryId], references: [id], onDelete: Cascade)

  @@map("lottery_configurations")
}

// ============================================================
// 5. LotteryBallType
// Una fila por cada "tipo de bola" que compone el juego
// (ej. powerball, powerplay, mega_ball, megaplier, lucky_ball...)
// ============================================================
model LotteryBallType {
  id            String       @id @default(cuid())
  lotteryId     String
  name          String // "powerball", "megaplier"
  abbreviation  String? // "PB", "M"
  category      BallCategory
  minBall       Int?
  maxBall       Int?
  allowZero     Boolean      @default(false)
  isString      Boolean      @default(false)
  isMultiplier  Boolean      @default(false)
  playerPicked  Boolean      @default(false)
  allowedValues Json? // ej. [2,3,4,5,10] para multiplicadores con valores fijos
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lottery     Lottery      @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  drawNumbers DrawNumber[]

  @@unique([lotteryId, name])
  @@index([lotteryId])
  @@map("lottery_ball_types")
}

// ============================================================
// 6. LotteryDrawSchedule
// Normaliza drawDays: { Sunday: false, Monday: true, ... } en filas,
// en vez de un string tipo "drawDays" serializado como en el schema original.
// ============================================================
model LotteryDrawSchedule {
  id        String    @id @default(cuid())
  lotteryId String
  dayOfWeek DayOfWeek
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  lottery Lottery @relation(fields: [lotteryId], references: [id], onDelete: Cascade)

  @@unique([lotteryId, dayOfWeek])
  @@index([lotteryId])
  @@map("lottery_draw_schedules")
}

// ============================================================
// 7. Draw
// ============================================================
model Draw {
  id             String     @id @default(cuid())
  lotteryId      String
  externalDrawId Int? // drawID / drawNumber crudo del proveedor -> clave de idempotencia al sincronizar
  drawNumber     String?
  drawDate       DateTime   @db.Date
  drawTime       String?
  details        String?    @db.Text // "For states except California."
  note           String?    @db.Text // "POWER PLAY: 2"
  hasWinner      Boolean    @default(false)
  status         DrawStatus @default(SCHEDULED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lottery        Lottery          @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  numbers        DrawNumber[]
  prizes         PrizeBreakdown[]
  jackpotHistory JackpotHistory[]

  @@unique([lotteryId, externalDrawId])
  @@index([lotteryId, drawDate])
  @@index([drawDate])
  @@map("draws")
}

// ============================================================
// 8. DrawNumber
// Normaliza winningNumbers[] + additionalNumbers[] del resultado real
// del sorteo (no confundir con additionalNumbers[] de gameDetails, que
// describe la CONFIGURACIÓN y ahora vive en LotteryBallType).
// Una fila por bola sorteada en vez de un string tipo "6,21,28,49,60".
// ============================================================
model DrawNumber {
  id         String       @id @default(cuid())
  drawId     String
  ballTypeId String? // null cuando es una bola principal sin tipo específico
  category   BallCategory @default(MAIN)
  position   Int // posición dentro de la combinación (1..n) -> orden estable
  value      String // string para soportar ceros a la izquierda (Pick 3, etc.)

  draw     Draw             @relation(fields: [drawId], references: [id], onDelete: Cascade)
  ballType LotteryBallType? @relation(fields: [ballTypeId], references: [id], onDelete: SetNull)

  @@unique([drawId, category, position])
  @@index([drawId])
  @@index([ballTypeId])
  @@map("draw_numbers")
}

// ============================================================
// 9. PrizeBreakdown
// ============================================================
model PrizeBreakdown {
  id             String   @id @default(cuid())
  drawId         String
  matchPattern   String // "5 + 1"
  prizeAmountRaw String? // "$196 Million" (texto original del proveedor)
  prizeAmount    Decimal? @db.Decimal(15, 2) // valor parseado cuando es posible
  winnersCount   Int? // "winner" en el JSON suele venir null
  createdAt      DateTime @default(now())

  draw Draw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@index([drawId])
  @@map("prize_breakdowns")
}

// ============================================================
// 10. JackpotHistory
// Snapshot del jackpot en el momento de la consulta. Un mismo Draw,
// mientras está SCHEDULED, puede tener varios snapshots a medida que
// el jackpot estimado sube día a día; también guarda el jackpot/cash
// del PRÓXIMO sorteo tal como lo entrega el proveedor en cada llamada.
// ============================================================
model JackpotHistory {
  id                String    @id @default(cuid())
  drawId            String
  jackpotRaw        String? // "$196 MILLION"
  jackpotAmount     Decimal?  @db.Decimal(15, 2)
  cashPayoutRaw     String?
  cashPayoutAmount  Decimal?  @db.Decimal(15, 2)
  nextDrawDate      DateTime?
  nextJackpotRaw    String?
  nextJackpotAmount Decimal?  @db.Decimal(15, 2)
  nextCashRaw       String?
  nextCashAmount    Decimal?  @db.Decimal(15, 2)
  totalPrizePool    Decimal?  @db.Decimal(15, 2)
  overallWinners    Int?
  recordedAt        DateTime  @default(now())

  draw Draw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@index([drawId, recordedAt])
  @@map("jackpot_history")
}

// ============================================================
// 11. ApiRequestLog
// Auditoría de consumo de créditos de la API del proveedor: clave
// para el ahorro/monitoreo definido al inicio del proyecto.
// ============================================================
model ApiRequestLog {
  id          String    @id @default(cuid())
  countryId   String?
  endpoint    String // "lottery-results/game-result"
  status      String // "success"
  message     String?
  rowCount    Int?
  creditUsed  Int       @default(0)
  systemTime  DateTime?
  requestedAt DateTime  @default(now())

  country Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)

  @@index([countryId, requestedAt])
  @@index([endpoint])
  @@map("api_request_logs")
}
