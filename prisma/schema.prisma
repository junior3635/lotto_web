generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// 1. Países (Country)
// Soporta la estrategia multi-país de la Fase 1 y Fase 2
// ------------------------------------------------------
model Country {
  id        String    @id
  code      String    @unique
  name      String
  slug      String    @unique
  flagEmoji String
  currency  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lotteries Lottery[]

  @@map("countries")
}

// ------------------------------------------------------
// 2. Loterías (Lottery)
// Configuración técnica y metadata de cada lotería
// ------------------------------------------------------
model Lottery {
  id                  String   @id @default(cuid())
  countryId           String
  name                String
  slug                String
  description         String?  @db.Text
  logoUrl             String?
  primaryColor        String?
  secondaryColor      String?
  drawDays            String   @db.LongText
  drawTime            String?
  totalNumbers        Int
  numberRangeMax      Int
  totalSpecialBalls   Int      @default(1)
  specialBallRangeMax Int
  specialBallName     String?
  hasMultiplier       Boolean  @default(true)
  multiplierName      String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  draws               Draw[]
  country             Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, slug])
  @@index([countryId])
  @@map("lotteries")
}

model Draw {
  id                   String           @id @default(cuid())
  lotteryId            String
  drawNumber           String?
  drawDate             DateTime
  winningCombination   String           @db.LongText
  estimatedJackpot     Decimal?         @db.Decimal(15, 2)
  jackpotFormatted     String?
  hasWinner            Boolean          @default(false)
  nextDrawDate         DateTime?
  nextEstimatedJackpot Decimal?         @db.Decimal(15, 2)
  nextJackpotFormatted String?
  status               DrawStatus       @default(COMPLETED)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lottery              Lottery          @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  prizes               PrizeBreakdown[]

  @@index([lotteryId, drawDate])
  @@index([drawDate])
  @@map("draws")
}

// ------------------------------------------------------
// 4. Premios y Desglose (PrizeBreakdown)
// Tabla detallada de ganadores y montos por categoría
// ------------------------------------------------------
model PrizeBreakdown {
  id                    String   @id @default(cuid())
  drawId                String
  categoryName          String
  winnersCount          Int      @default(0)
  prizeAmount           Decimal  @db.Decimal(15, 2)
  multiplierPrizeAmount Decimal? @db.Decimal(15, 2)
  createdAt             DateTime @default(now())
  draw                  Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@index([drawId])
  @@map("prize_breakdowns")
}

enum DrawStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}
